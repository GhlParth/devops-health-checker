# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.

# ─── LLM ────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ─── GitHub ─────────────────────────────────────────────────────────────────
# Personal Access Token with read:repo scope
GITHUB_TOKEN=your-github-pat-here

# ─── AWS ─────────────────────────────────────────────────────────────────────
# Prefer IAM roles on EC2/EKS. Only use keys for local dev.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ─── API Server ──────────────────────────────────────────────────────────────
DEVOPS_API_HOST=127.0.0.1
DEVOPS_API_PORT=8080
# Long random string — generate with: python -c "import secrets; print(secrets.token_hex(32))"
DEVOPS_API_TOKEN=

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
